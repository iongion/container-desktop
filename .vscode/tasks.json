{
  "version": "2.0.0",
  "tasks": [
    {
      // The normal dev flow on the shell that ships: `tauri dev` builds the Rust binary and serves the renderer
      // from Vite. Kept as a background task so stopping it fully shuts the app down.
      "label": "dev: tauri (mock)",
      "detail": "yarn dev:mock — Tauri with the deterministic mock backend",
      "type": "shell",
      "command": "yarn dev:mock",
      "isBackground": true,
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "problemMatcher": {
        "owner": "container-desktop-dev",
        "source": "container-desktop",
        // No diagnostics are parsed from dev output; "^$" never captures a problem.
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Compiling|Running BeforeDevCommand",
          "endsPattern": "Running `target/debug"
        }
      }
    }
  ]
}
